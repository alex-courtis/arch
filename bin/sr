#!/usr/bin/env sh

out="/tmp/sr.log"

cmd=""

rm -f "${out}"

while getopts gms opt; do
	case "$opt" in
		m)
			if [ "${XDG_CURRENT_DESKTOP}" != "gamescope" ]; then
				cmd="mangohud ${cmd}"
			fi
			;;
		g)
			cmd="${cmd} gamemoderun"
			;;
		s)
			if [ "${XDG_CURRENT_DESKTOP}" != "gamescope" ]; then
				scale="true"
				exit 1
			fi
			;;
		*)
			exit 1
			;;
	esac
done
shift $((OPTIND-1))

if [ "${scale}" ]; then
	way-displays -s scaling off >> "${out}" 2>&1
fi

echo "${cmd} ${@}" >> "${out}"

env >> "${out}"

${cmd} "${@}" >> "${out}" 2>&1

if [ "${scale}" ]; then
	way-displays -s scaling on >> "${out}" 2>&1
fi

